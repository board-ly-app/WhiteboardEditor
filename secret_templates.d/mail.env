# === .secrets/mail.env ========================================================
#
# Configuration options for interfacing with the mailserver.
#
# ==============================================================================

# --- Required Variables -------------------------------------------------------
#
# The following options must be set in order for the app to interface with the
# mailserver.
#
# ------------------------------------------------------------------------------

# -- SMTP host domain name
SMTP_HOST=
# -- SMTP username
SMTP_USER=
# -- SMTP password
SMTP_PASS=

# -- Domain name of mailserver; needed for email addresses
EMAIL_DOMAIN_NAME=

# -- JWT Secret for signing account confirmation tokens
EMAIL_VERIFICATION_SECRET=

# -- If set to "TRUE", allows creation of new user accounts without verifying
# the email address; if set to "FALSE", verification of the provided email
# address is required.
# Should be set to "FALSE" in a production environment.
SKIP_EMAIL_VERIFICATION=FALSE

# -- Time until an account verification email expires, in seconds
EMAIL_VERIFICATION_EXPIRATION_SECS=600

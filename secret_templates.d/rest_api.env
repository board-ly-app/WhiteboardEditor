# -- Default number of requests to permit in a given time period
GLOBAL_RATE_LIMIT=

# -- Default rate limiting time period, in seconds
GLOBAL_RATE_LIMIT_WINDOW_SECS=

# -- Number of account creation requests to permit in a given time period
SIGNUP_RATE_LIMIT=

# -- Signup rate limiting time period, in seconds
SIGNUP_RATE_LIMIT_WINDOW_SECS=

# -- Number of login/authentication requests to permit in a given time period
AUTH_RATE_LIMIT=

# -- Login/authentication rate limiting time period, in seconds
AUTH_RATE_LIMIT_WINDOW_SECS=
